{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "data": {
          ".validate": "newData.child('schemaVersion').val() === 1"
        }
      }
    }
  }
}
